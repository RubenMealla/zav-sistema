{
  "expo": {
    "name": "ZAV Vendedor",
    "slug": "zav-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zav",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "bo.zav.gestion.vendedor",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "10000"
    },
    "android": {
      "package": "bo.zav.gestion.vendedor",
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 10000
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050505",
          "image": "./assets/images/icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ZAV necesita tu ubicación únicamente al confirmar una entrega o cuando eliges usar tu posición actual."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://zav-api-2026.onrender.com"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    }
  }
}
