# En el emulador Android, 10.0.2.2 permite acceder a la API local.
# En un telefono fisico, utilizar la IP de la PC en la misma red.
# El APK release obtiene la URL desde el workflow de publicacion.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001

# Mapa OpenFreeMap: no requiere clave en el dispositivo.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
