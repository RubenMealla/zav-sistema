# Ejemplo de configuracion local de la API ZAV.
# Usa apps/api/.env para los valores reales; no lo subas a GitHub.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/zav_db
WEB_ORIGIN=http://localhost:3000
# Generar una clave distinta y aleatoria en cada entorno (minimo 32 bytes).
# El servidor no inicia si este valor esta vacio.
JWT_SECRET=
