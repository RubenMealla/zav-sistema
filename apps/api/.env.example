# ==================================================
# ZAV - Configuracion de ejemplo de la API
# ==================================================

# Entorno de ejecucion
NODE_ENV=development

# Puerto del servidor NestJS
PORT=3001

# ==================================================
# Base de datos PostgreSQL
# ==================================================
# Configuracion de ejemplo.
# La conexion con PostgreSQL se implementara
# durante el desarrollo de la persistencia.

DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/zav_db

# ==================================================
# Aplicacion web
# ==================================================
# Origen local de la aplicacion Next.js.
# La configuracion de CORS se implementara
# cuando se integre la API con el frontend.

WEB_ORIGIN=http://localhost:3000
