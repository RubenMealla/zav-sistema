# URL interna de la API de NestJS, consultada solo por el servidor Next.js.
API_BASE_URL=http://localhost:3001

# Controla las secciones públicas en preparación de la landing:
# Catálogo, Promociones y Noticias. "Nosotros" y el acceso interno permanecen visibles.
# Mantener false/ausente en producción mientras esas secciones no estén funcionalmente cerradas.
ZAV_LANDING_EXTENDIDA=false

