    "sqlSoloLectura": "WITH fisico AS (\n SELECT s.lote_id,s.cantidad_fisica FROM saldo_inventario s JOIN ubicacion u ON u.id=s.ubicacion_id WHERE u.codigo='EN_DISTRIBUCION'\n),custodia AS (\n SELECT lote_id,sum(cantidad) AS cantidad FROM saldo_custodia GROUP BY lote_id\n),diferencias AS (\n SELECT COALESCE(f.lote_id,c.lote_id) AS lote_id FROM fisico f FULL JOIN custodia c USING(lote_id)\n WHERE COALESCE(f.cantidad_fisica,0)<>COALESCE(c.cantidad,0)\n)\nSELECT current_database() AS base,now() AS consultado_en,\n(SELECT count(*) FROM typeorm_migraciones) AS migraciones,\n(SELECT count(*) FROM producto) AS presentaciones,\n(SELECT count(*) FROM pedido) AS pedidos,\n(SELECT count(*) FROM movimiento) AS movimientos,\n(SELECT count(*) FROM saldo_inventario WHERE cantidad_fisica<0) AS saldos_negativos,\n(SELECT count(*) FROM saldo_custodia WHERE cantidad<0) AS custodias_negativas,\n(SELECT count(*) FROM custodia_libre WHERE disponible<0) AS libres_negativos,\n(SELECT count(*) FROM producto WHERE producto_comercial_id IS NULL) AS sku_sin_jerarquia,\n(SELECT count(*) FROM saldo_custodia WHERE vendedor_id IS NULL AND cantidad<>0) AS custodias_sin_responsable,\n(SELECT count(*) FROM diferencias) AS diferencias_distribucion_custodia;",
